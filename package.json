{
  "name": "agy-ask-extension",
  "displayName": "Antigravity Ask User Question",
  "description": "Show an AI agent's multiple-choice question in the sidebar and write the chosen answer to a file in the workspace.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ycookiey/agy-ask-question.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "ai",
    "agent",
    "question",
    "human-in-the-loop"
  ],
  "files": [
    "out/**/*.js",
    "media",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:agyAskView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agyAskContainer",
          "title": "Ask Agy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agyAskContainer": [
        {
          "id": "agyAskView",
          "name": "Questions",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
